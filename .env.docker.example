APP_NAME=Smart-CBT
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database PostgreSQL smart-cbt-db
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smart_cbt
DB_USERNAME=smart_cbt
DB_PASSWORD=smart_cbt_password

# Session, Cache, & Queue menggunakan Redis smart-redis di smart-app-yayasan
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=smart-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1
REDIS_PREFIX=smart_cbt_

FILESYSTEM_DISK=public

# Port eksternal Nginx smart-cbt (default: 8001)
CBT_WEB_PORT=8001
